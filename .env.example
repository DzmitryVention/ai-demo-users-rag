# --- API (apps/api) ---------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
# Comma-separated list of admin emails (compared case-insensitively)
ADMIN_EMAILS=admin@example.com

# Public Firebase web config (Firebase console → Project settings → Your apps)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Local only: path to a service-account JSON is NOT needed. firebase-admin verifies
# ID tokens with Google's public keys; it only needs FIREBASE_PROJECT_ID.
